# ---------------------------------------------------------------------------
# Copy file này thành .env rồi điền giá trị thật (dùng cho chạy local).
# Trên GitHub Actions thì đặt từng biến dưới đây vào Settings > Secrets.
# TUYỆT ĐỐI không commit .env
# ---------------------------------------------------------------------------

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key - CHỈ dùng trong sync job, KHÔNG bao giờ đưa xuống frontend
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Google (Cloud Console > Service Account > Keys)
# Có thể là nội dung JSON trên 1 dòng, hoặc đường dẫn tới file .json
GOOGLE_SA_JSON={"type":"service_account","project_id":"..."}
# ID sheet lấy từ URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# ID folder Drive chứa ảnh gốc (tuỳ chọn, chỉ dùng để kiểm tra quyền)
DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Cloudflare R2 (R2 > Manage R2 API Tokens)
R2_ACCOUNT_ID=abc123def456
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=tiemhoa-images
# URL public của Worker đứng trước bucket (KHÔNG có dấu / ở cuối)
R2_PUBLIC_BASE=https://anh-shop.ten-ban.workers.dev

# Chạy thử không ghi gì: DRY_RUN=1
DRY_RUN=0
